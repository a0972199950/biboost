{
  "name": "bilibili-cdn-switcher-tools",
  "private": true,
  "type": "module",
  "description": "Dev tooling only (dependencies for the Node scripts under scripts/); not the extension itself. The extension source lives in src/.",
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "test:private": "node --test \"src/private/test/*.test.mjs\"",
    "e2e:cloud": "node scripts/e2e-cloud-sync.mjs",
    "e2e:survey": "node scripts/e2e-survey.mjs",
    "build": "node scripts/build.mjs",
    "build:safari": "node scripts/build-safari.mjs",
    "package": "node scripts/package.mjs",
    "package:mac": "bash tools/cdn-speedtest-app/build-mac.sh",
    "gen-icons": "node scripts/gen-icons.mjs",
    "changelog:validate": "node scripts/changelog.mjs validate",
    "publish-stores": "node scripts/publish-stores.mjs",
    "test:whats-new": "node scripts/test-whats-new.mjs",
    "private:setup": "node scripts/private-repo.mjs setup",
    "private:push": "node scripts/private-repo.mjs push",
    "private:pull": "node scripts/private-repo.mjs pull",
    "prepare": "node scripts/setup-hooks.mjs || exit 0",
    "cdn-list:pull": "node scripts/cdn-list.mjs pull",
    "cdn-list:diff": "node scripts/cdn-list.mjs diff",
    "cdn-list:publish": "node scripts/cdn-list.mjs publish",
    "cdn-list:rollback": "node scripts/cdn-list.mjs rollback",
    "cdn-list:history": "node scripts/cdn-list.mjs history",
    "cdn-list:status": "node scripts/cdn-list.mjs status"
  },
  "devDependencies": {
    "jsdom": "^27.0.1",
    "jszip": "^3.10.1",
    "puppeteer": "^25.5.0",
    "sharp": "^0.35.3",
    "wrangler": "^4.149.0"
  }
}
