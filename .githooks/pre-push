#!/bin/sh
# pre-push：
#   1. 更新紀錄檢查：這次 push 有沒有更新 src/changelog.json（尚未上架的新功能清單）
#   2. 敏感資料檢查（scripts/sensitive-check.mjs）：規則＋AI，沒通過就擋下
#   3. 這台電腦有私人 repo 時順便推上去
# 安裝：npm install（prepare）或 node scripts/setup-hooks.mjs：core.hooksPath 設成主目錄 .githooks 的絕對路徑。
#
# 更新紀錄沒有變動時會互動詢問是否仍要 push：選 No（預設）就擋下，必須補上清單才能 push。
# 沒有終端機可互動（例如 AI agent、CI）時一律擋下；確定這次改動不需要記錄時，
# 用環境變數略過：CHANGELOG_CHECK_IGNORE=1 git push

ROOT=$(git rev-parse --show-toplevel)
# 主目錄（在 worktree 或舊分支上也一樣）：敏感資料檢查一律用主目錄的腳本與規則檔，不用目前分支簽出的舊版
MAIN=$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")

# stdin 是 git 給的「<local_ref> <local_sha> <remote_ref> <remote_sha>」清單，先讀完，之後才能從終端機問問題
refs=$(cat)

if ! command -v node >/dev/null 2>&1; then
  echo "pre-push: 找不到 node，沒辦法做檢查，已擋下 push（GUI 的 git 工具常常找不到 nvm／brew 的 node，請從終端機 push）。" >&2
  exit 1
fi

# ---------- 1. 更新紀錄（先做：這裡擋下就不用等 AI 檢查） ----------
needs_prompt=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "$local_ref" ] && continue
  node "$ROOT/scripts/changelog.mjs" check-push "$local_ref" "$local_sha" "$remote_ref" "$remote_sha"
  rc=$?
  if [ "$rc" -eq 10 ]; then
    needs_prompt=1
  elif [ "$rc" -ne 0 ]; then
    exit 1
  fi
done <<REFS
$refs
REFS

if [ "$needs_prompt" -eq 1 ]; then
  if [ "$CHANGELOG_CHECK_IGNORE" = "1" ]; then
    echo "pre-push: CHANGELOG_CHECK_IGNORE=1，略過更新紀錄檢查。" >&2
  else
    echo "" >&2
    echo "No new features/bugs found. Please check if any changes need to record." >&2
    echo "請把使用者看得到的新功能／修正寫進 src/changelog.json 的 unreleased。" >&2
    if ! { exec 3</dev/tty; } 2>/dev/null; then
      echo "（沒有終端機可互動，已擋下 push。確定不需要記錄時：CHANGELOG_CHECK_IGNORE=1 git push）" >&2
      exit 1
    fi
    printf "Ignore and push: No/Yes [y/N] " >&2
    read -r answer <&3
    exec 3<&-
    case "$answer" in
      [Yy]|[Yy][Ee][Ss]) ;;
      *) echo "已取消 push：請更新 src/changelog.json 後再 push。" >&2; exit 1 ;;
    esac
  fi
fi

# ---------- 2. 敏感資料檢查（找不到腳本也擋，不能靜默略過） ----------
if [ ! -f "$MAIN/scripts/sensitive-check.mjs" ]; then
  echo "pre-push: 找不到 $MAIN/scripts/sensitive-check.mjs（私人 repo 的檔案；新電腦先跑 npm run private:setup），沒辦法做敏感資料檢查，已擋下 push。" >&2
  exit 1
fi
printf '%s\n' "$refs" | (cd "$ROOT" && node "$MAIN/scripts/sensitive-check.mjs" push "${1:-origin}") || exit 1

# ---------- 3. 私人 repo（失敗只印警告，不影響這次 push） ----------
if [ -d "$ROOT/.git-private" ]; then
  node "$ROOT/scripts/private-repo.mjs" push </dev/null || true
fi
exit 0
