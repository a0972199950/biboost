
# OS / 編輯器
Thumbs.db
desktop.ini
.DS_Store
.vscode/

# Node（scripts/*.mjs 用）
node_modules/

# 本機密鑰：截圖用的 bilibili 登入 cookie（含 SESSDATA，等同帳號憑證，絕對不要 commit）
.env.local

# Safari / Xcode 暫存檔
safari/*/build/
safari/*/.build/
safari/*.xcodeproj/xcuserdata/
safari/*.xcworkspace/xcuserdata/
safari/*.xcworkspace/xcshareddata/
safari/*/DerivedData/
/
# 瀏覽器自動化工具（Playwright MCP）的暫存紀錄
.playwright-mcp/

# /cdn-speedtest 測速結果（含當地出口 IP）
cdn-speedtest-results/


# Python 快取
__pycache__/

# 私人資料，只留本機
research/
spec/

# 發版產物（npm run package；/release 會上傳到 GitHub Release）
release/

# Cloudflare Worker 本機密鑰 / 暫存
tools/report-worker/.dev.vars
tools/site/.dev.vars
tools/translate-worker/.dev.vars
# 簽章憑證，只進私人 repo
tools/cdn-speedtest-app/signing/
tools/report-worker/.wrangler/

# 私人資料，只留本機
promotions/

# 私人資料，只留本機
/growth-report/

# 本機設定，只進私人 repo
.claude/skills/
.claude/settings.local.json

# 私人資料，只進私人 repo
/store/

# 私人 repo（scripts/private-repo.mjs）：資料庫本身，與 setup 時被覆蓋前的本機檔案備份
/.git-private/
/.private-restore-backup/

# 私人模組，只進私人 repo
/admin/
tools/site/public/
tools/site/.wrangler/
tools/translate-worker/.wrangler/

# 私人模組：只進私人 repo，也不打包
/src/private/

# 節點清單（伺服器下發，scripts/cdn-list.mjs）：本機工作檔、每次發布重建的靜態網站內容
/.cdn-list/
tools/static-site/public/
tools/static-site/.wrangler/
